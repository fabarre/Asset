{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuditReport",
  "description": "Contratto dati tipizzato per il report di revisione emesso da adversarial_auditor all'Orchestratore",
  "type": "object",
  "properties": {
    "verdict": { "type": "string", "enum": ["APPROVED", "REJECTED"] },
    "timestamp": { "type": "string" },
    "invariants_checked": { "type": "integer", "minimum": 1 },
    "invariants_passed": { "type": "integer", "minimum": 0 },
    "invariants_failed": { "type": "integer", "minimum": 0 },
    "web_worker_syntax_verified": { "type": "boolean" },
    "excel_acyclic_verified": { "type": "boolean" },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "invariant_id": { "type": "string" },
          "description": { "type": "string" },
          "expected": { "type": ["number", "string"] },
          "actual": { "type": ["number", "string"] },
          "tolerance": { "type": "number" }
        },
        "required": ["invariant_id", "description", "expected", "actual"]
      }
    }
  },
  "required": [
    "verdict",
    "timestamp",
    "invariants_checked",
    "invariants_passed",
    "invariants_failed",
    "web_worker_syntax_verified",
    "excel_acyclic_verified"
  ],
  "additionalProperties": false
}
